{
  "rules": {
    "paperioPocket": {
      "players": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state','revision','device','updatedAt']) && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() === 1) || newData.child('revision').val() === data.child('revision').val() + 1)",
          "state": {
            ".validate": "newData.hasChildren(['coins','gems','stats','settings','daily'])",
            "coins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0" },
            "gems": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0" }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
